{
  "name": "voicelens",
  "version": "0.2.0",
  "description": "Voice input and audio transcription for DeepSeek Harness and any skill-reading agent: a composer mic button (browser speech), a transcribe_audio tool, and a harness-agnostic `voicelens` CLI with configurable ASR providers.",
  "type": "module",
  "bin": {
    "voicelens": "./bin/voicelens.js"
  },
  "exports": {
    ".": "./dsh/index.js",
    "./dsh": "./dsh/index.js",
    "./client": "./client/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "dsh",
    "client",
    "skills",
    "installers",
    "cordis.patch.yml",
    "INSTALL.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "speech-to-text",
    "voice-input",
    "voice",
    "transcription",
    "asr",
    "audio",
    "whisper",
    "agent-skill",
    "ai-assistant",
    "claude-code",
    "codex",
    "plugin",
    "modlens"
  ],
  "author": "Ethan Huang",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
